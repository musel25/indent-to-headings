{
  "name": "indent-to-headings",
  "version": "1.3.1",
  "description": "Convert plain indented outlines into Markdown headings in Obsidian.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "npm run build && node test/converter.test.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json package.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "markdown",
    "outline"
  ],
  "author": "Musel25",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.1",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
